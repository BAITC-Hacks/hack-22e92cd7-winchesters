# Required. A funded key: the API rejects calls from a key with no credit
# balance before it ever looks at the model id.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional. Model ids default to the values in backend/settings.py; override
# only to pin a different tier. Never hard-code a model id at a call site.
# MODEL_JUDGE=claude-opus-5
# MODEL_EXTRACT=claude-sonnet-5
# MODEL_CHAT=claude-sonnet-5

# Optional. Reasoning effort: low | medium | high | xhigh | max.
# Left empty the parameter is not sent at all.
# EFFORT_JUDGE=high
# EFFORT_EXTRACT=medium

# Optional. How many Claude calls may be in flight at once.
# MAX_CONCURRENT_LLM_CALLS=4

# Optional. Defaults to a SQLite file at backend/data/invision.db.
# Create or upgrade it with: python -m backend.db init
# DATABASE_URL=sqlite:///C:/path/to/invision.db

# Optional, and on its way out. Whisper is unusable for Kazakh
# (measured 60-77% word error rate on spontaneous speech), so task INP-01
# makes the applicant's written presentation the input that is scored.
OPENAI_API_KEY=
