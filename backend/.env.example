# Required. A funded key: the API rejects calls from a key with no credit
# balance before it ever looks at the model id.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required. Signs login tokens; the backend refuses to start without it.
# The value below is a shared, public dev secret: it is accepted only while
# DEMO_MODE=1 (the default). Anywhere real, set DEMO_MODE=0 and generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=dev-only-invisionu-local-secret-not-for-production
# Optional. Token lifetime in minutes; the user logs in again after it.
# AUTH_TOKEN_TTL_MINUTES=480

# Optional. 1 (default) seeds the demo committee account
# committee@invisionu.edu / demo2026 on `python -m backend.db init` and lets it
# log in, and accepts the dev AUTH_SECRET above. 0 turns all of that off.
# DEMO_MODE=1

# Optional. Browser origins allowed to call the API, comma-separated.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Model ids default to the values in backend/settings.py; override
# only to pin a different tier. Never hard-code a model id at a call site.
# MODEL_JUDGE=claude-opus-5
# MODEL_EXTRACT=claude-sonnet-5
# MODEL_CHAT=claude-sonnet-5

# Optional. Reasoning effort: low | medium | high | xhigh | max.
# Left empty the parameter is not sent at all.
# EFFORT_JUDGE=high
# EFFORT_EXTRACT=medium

# Optional. How many Claude calls may be in flight at once.
# MAX_CONCURRENT_LLM_CALLS=4

# Optional. Defaults to a SQLite file at backend/data/invision.db.
# Create or upgrade it with: python -m backend.db init
# DATABASE_URL=sqlite:///C:/path/to/invision.db

# Speech recognition (INP-01). Off by default. The applicant's written
# presentation is the input that is scored; ASR would only ever produce quote
# material. The engine is pinned in settings.py to ElevenLabs Scribe v2.
# Whisper is not used: it is unusable for Kazakh (measured 60-77% word error
# rate on spontaneous speech). Both lines are needed to switch it on.
ASR_ENABLED=0
ELEVENLABS_API_KEY=
